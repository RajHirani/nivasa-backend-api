PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://nivasa_admin:password123@localhost:5432/nivasa?schema=public"
TERMS_VERSION=1.0
OTP_HASH_SECRET=change-me
# Dev only: when set (and NODE_ENV != production) every OTP is this code. The SMS provider is not wired yet; OTPs are logged to the console.
OTP_DEV_FIXED_CODE=123456
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Base URL clients use to reach this API (used in signed file links)
PUBLIC_BASE_URL=http://localhost:3000
# Where uploaded files live. Only 'local' exists today; an S3 driver can be added behind the same interface.
STORAGE_DRIVER=local
UPLOAD_DIR=./storage
FILE_URL_TTL_SECONDS=3600
