PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://nivasa_admin:password123@localhost:5432/nivasa?schema=public"
TERMS_VERSION=1.0
OTP_HASH_SECRET=change-me
# Dev only: when set (and NODE_ENV != production) every OTP is this code. OTPs are logged to the console while SMS_DRIVER=console.
OTP_DEV_FIXED_CODE=123456
JWT_SECRET=change-me
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Base URL clients use to reach this API (used in signed file links)
PUBLIC_BASE_URL=http://localhost:3000
# Where uploaded files live. Only 'local' exists today; an S3 driver can be added behind the same interface.
STORAGE_DRIVER=local
UPLOAD_DIR=./storage
FILE_URL_TTL_SECONDS=3600
# Directory: which occupancy statuses / roles each tab lists (comma separated codes)
DIRECTORY_OCCUPANCY_CODES=RESIDING
DIRECTORY_COMMITTEE_ROLES=PRESIDENT,SECRETARY,TREASURER,COMMITTEE
DIRECTORY_GUARD_ROLES=SECURITY
# How SMS is delivered. 'console' logs only (not allowed in production). Providers plug into lib/sms/.
SMS_DRIVER=console
# How email is delivered. 'console' logs only (not allowed in production); 'gmail' is SMTP with an app password. Providers plug into lib/email/.
EMAIL_DRIVER=gmail
GMAIL_USER=
GMAIL_PASS=
# Master switch for EVERY email the API sends (sign in codes, staff and society admin invitations). All emails go through lib/email sendEmail.
# Not set = ON in production, OFF everywhere else, so a local run never emails anybody unless you set this to true. true / false.
EMAIL_SEND_ENABLED=false
# Platform console sign in: lock after this many wrong codes within the window
PLATFORM_OTP_MAX_FAILED=3
PLATFORM_OTP_LOCK_MINUTES=15
# Where invited Nivas staff are told to sign in
PLATFORM_CONSOLE_URL=http://localhost:5173/platform/login
# Browser origins (besides the console's own, taken from PLATFORM_CONSOLE_URL) allowed to call the API with cookies, comma separated
CORS_ORIGINS=
# The platform console keeps its refresh token in an httpOnly cookie. Secure needs https (default: on in production only)
COOKIE_SECURE=false
# A just-rotated console refresh token is still accepted for this many seconds (tabs refreshing at the same time)
REFRESH_REUSE_GRACE_SECONDS=10
