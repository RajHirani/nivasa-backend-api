  service_provider                                         service_provider[]
  service_provider_household                               service_provider_household[]
  service_provider_review                                  service_provider_review[]
  service_type                                             service_type[]
  society_contact                                          society_contact[]
  upload                                                   upload[]
  user_resident_map                                        user_resident_map[]
  user_society_map_user_society_map_added_byToapp_user     user_society_map[]           @relation("user_society_map_added_byToapp_user")
  user_society_map_user_society_map_user_idToapp_user      user_society_map[]           @relation("user_society_map_user_idToapp_user")
  user_society_role_user_society_role_ended_byToapp_user   user_society_role[]          @relation("user_society_role_ended_byToapp_user")
